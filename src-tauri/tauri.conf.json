{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codbot",
  "version": "0.3.0",
  "identifier": "com.cbm.codbot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codbot",
        "width": 1280,
        "height": 840,
        "backgroundThrottling": "disabled",
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Tâches ClickUp et agents Claude Code",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRDJEOEE5MzI2NUEwODYKUldTR29HVXlxZGpTNGI1S0c0ZERnYjJJWDZva3RXZ25XOFkwOU1KOUJzc3RxOGlwa0h4MHBHZnQK",
      "endpoints": [
        "https://github.com/My5t3r10us/codbot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
